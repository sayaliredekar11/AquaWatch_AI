# AquaWatch AI - Environment Variables Example
# Copy this file to .env and configure with your credentials

DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/aquawatch

# JWT Authentication Settings
SECRET_KEY=your_super_secret_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Machine Learning Prediction Integration Settings (Day 4)
# Supported modes: 'none' (model unavailable/pending), 'file' (Option A: local model artifact), 'api' (Option B: external ML API)
ML_INTEGRATION_MODE=file
ML_MODEL_PATH=models/AquaWatchAI_Best_Model.joblib
ML_SERVICE_URL=http://localhost:8501/predict
ML_SERVICE_TIMEOUT_SECONDS=5.0
ML_MOCK_MODE=false
